# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma separated list of allowed browser origins (only needed if the client is served from a different origin)
CORS_ORIGIN=http://localhost:5173
# Secret used to sign booking/receipt tokens. REQUIRED in production (any long random string).
TOKEN_SECRET=change-me-to-a-long-random-string

# ---- Supabase (values taken from the original kakkson_booking.html) ----
SUPABASE_URL=https://ctpgmhixlaxnhhrnkazz.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN0cGdtaGl4bGF4bmhocm5rYXp6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkwNTcwNDMsImV4cCI6MjA3NDYzMzA0M30.AI2UMryv-Whu2wVpQ8JeLWVThLVQhsJSero6bzgn8oA
# Optional: if you add a service-role key it is used instead of the anon key for server-side reads/writes.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- EmailJS (values taken from the original file) ----
# NOTE: EmailJS rejects server-side calls unless you enable
# "Allow EmailJS API for non-browser applications" in Account > Security.
EMAILJS_PUBLIC_KEY=c3HEqY_tWmDMXZ7z_
# Recommended when calling EmailJS from a server (Account > General > Private Key)
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=service_7ieecyb
EMAILJS_GUEST_TEMPLATE_ID=template_nhtzzr2
EMAILJS_ADMIN_TEMPLATE_ID=template_q3gp2il

# ---- Misc ----
# How long (ms) hotel data is cached in memory for read-only endpoints. Booking writes always read fresh data.
CACHE_TTL_MS=10000
# Timezone used for dates printed on PDF vouchers
VOUCHER_TIMEZONE=Asia/Kolkata
